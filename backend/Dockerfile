 Берём официальный Node.js образ (alpine = лёгкая версия на базе Alpine Linux)
FROM node:18-alpine
 
# Устанавливаем рабочую директорию внутри контейнера
# Все последующие команды будут выполняться отсюда
WORKDIR /app
 
# Сначала копируем ТОЛЬКО package.json (до копирования кода)
# Это важно для кэширования: если код изменился, но зависимости — нет,
# Docker не будет заново запускать npm install
COPY package.json ./
 
# Устанавливаем зависимости
RUN npm install
 
# Теперь копируем весь остальной код
COPY . .
 
# Говорим Docker, что контейнер слушает порт 3000
# (это только документация — реально порт открывает docker-compose)
EXPOSE 3000
 
# Команда запуска приложения
CMD ["node", "server.js"]
 
